# Maintainer: Danny Rudd <danny.rudd@icloud.com>
pkgname=archeasy-git
pkgver=0.1.2.r0.g0000000
pkgrel=1
pkgdesc='A beginner-friendly Arch Linux software browser and config manager'
arch=('x86_64' 'aarch64')
url='https://github.com/danny19862025/ArchEasy'
license=('MIT' 'OFL-1.1')
depends=('gtk4>=4.10' 'libadwaita' 'fontconfig' 'glibc' 'gcc-libs' 'pacman' 'curl' 'python')
makedepends=('git' 'rust' 'pkgconf')
checkdepends=('lua' 'desktop-file-utils' 'rclone' 'fish')
optdepends=('flatpak: Flatpak software sources and permissions'
            'git: GitHub repository builds'
            'base-devel: build tools for GitHub and AUR packages'
            'fish: validate and run Fish presets after applying'
            'pacman-contrib: clean old cached packages while keeping three versions'
            'paru: AUR package installation' 'rclone: cloud config backups'
            'konsole: interactive package operations (or another supported terminal)'
            'pipewire: click sound playback with pw-play'
            'pciutils: GPU information' 'github-cli: config sharing'
            'timeshift: pre-update snapshots' 'snapper: pre-update snapshots')
provides=('archeasy')
conflicts=('archeasy')
options=('!debug') # The release profile already strips debug symbols.
source=('archeasy::git+https://github.com/danny19862025/ArchEasy.git')
sha256sums=('SKIP')

pkgver() {
    cd "$srcdir/archeasy"
    printf '%s.r%s.g%s' "$(sed -n 's/^version = "\([^"]*\)"/\1/p' Cargo.toml | head -n1)" \
        "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
    cd "$srcdir/archeasy"
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/^host: //p')"
}

build() {
    cd "$srcdir/archeasy"
    cargo build --release --frozen
}

check() {
    cd "$srcdir/archeasy"
    cargo test --frozen
    python tests/setup_store_smoke.py
    python tests/github_build_smoke.py
    python tests/snapshot_smoke.py
    python tests/maintenance_smoke.py
    luac -p presets/hypr/hyprland.lua
    lua tests/validate-hyprland.lua presets/hypr/hyprland.lua
    desktop-file-validate assets/archeasy.desktop
}

package() {
    cd "$srcdir/archeasy"
    install -Dm755 target/release/archeasy "$pkgdir/usr/bin/archeasy"
    install -Dm644 assets/archeasy.desktop "$pkgdir/usr/share/applications/archeasy.desktop"
    install -Dm644 assets/archeasy.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/archeasy.svg"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 assets/Octicons-LICENSE "$pkgdir/usr/share/licenses/$pkgname/Octicons-LICENSE"
    install -Dm644 assets/AppCleaner-LICENSE "$pkgdir/usr/share/licenses/$pkgname/AppCleaner-LICENSE"
    install -Dm644 assets/fonts/Ribeye-OFL.txt "$pkgdir/usr/share/licenses/$pkgname/Ribeye-OFL.txt"
}
